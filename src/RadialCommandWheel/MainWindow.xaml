<Window x:Class="RadialCommandWheel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RadialCommandWheel.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource WindowTitle}"
        Width="1260"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ui:ItemCaptionConverter x:Key="ItemCaptionConverter"/>
        <ui:ItemTypeNameConverter x:Key="ItemTypeNameConverter"/>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Background="#0A1018" BorderBrush="#1C2939"
                BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="{DynamicResource AppName}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#718399"/>
                    <Border Background="#172333" CornerRadius="5" Padding="7,2" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource HoldToOpen}" FontSize="8.5" Foreground="#6F91A8"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="—" ToolTip="{DynamicResource MinimizeTip}" Click="MinimizeButton_Click"
                        AutomationProperties.Name="{DynamicResource MinimizeTip}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
                        FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="□" ToolTip="{DynamicResource MaximizeTip}"
                        AutomationProperties.Name="{DynamicResource MaximizeTip}"
                        Click="MaximizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
                        FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Grid.Column="3" Content="✕" ToolTip="{DynamicResource HideTip}"
                        AutomationProperties.Name="{DynamicResource HideTip}"
                        Click="CloseButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
                        FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="#0C121C" BorderBrush="#1C2939" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Grid Width="42" Height="42" Margin="0,0,12,0">
                        <Ellipse Width="40" Height="40" Fill="#15283A" Stroke="#4CC9F0" StrokeThickness="1.5"/>
                        <Path Data="M 21,5 A 16,16 0 0 1 37,21 L 21,21 Z"
                              Fill="#4CC9F0" Opacity="0.9"/>
                        <Path Data="M 21,21 L 37,21 A 16,16 0 0 1 21,37 Z"
                              Fill="#8B76DB" Opacity="0.9"/>
                        <Path Data="M 5,21 A 16,16 0 0 1 21,5 L 21,21 Z"
                              Fill="#6BCB77" Opacity="0.9"/>
                        <Path Data="M 21,21 L 21,37 A 16,16 0 0 1 5,21 Z"
                              Fill="#F6C85F" Opacity="0.9"/>
                        <Ellipse Width="15" Height="15" Fill="#0C121C"/>
                        <Ellipse Width="5" Height="5" Fill="#F5F8FC"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource BrandName}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{DynamicResource BrandSubtitle}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9.5"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{DynamicResource NavConfigure}" Foreground="#627188" FontSize="10"
                               FontWeight="SemiBold" Margin="12,0,0,8"/>
                    <Button x:Name="WheelNavButton" Style="{StaticResource SidebarButtonStyle}"
                            AutomationProperties.Name="{DynamicResource NavWheel}"
                            Background="#182738" Click="WheelNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" Foreground="{StaticResource AccentBrush}" Width="24"/>
                            <TextBlock Text="{DynamicResource NavWheel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AppearanceNavButton" Style="{StaticResource SidebarButtonStyle}"
                            AutomationProperties.Name="{DynamicResource NavAppearance}"
                            Click="AppearanceNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" Foreground="#A78BFA" Width="24"/>
                            <TextBlock Text="{DynamicResource NavAppearance}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShortcutNavButton" Style="{StaticResource SidebarButtonStyle}"
                            AutomationProperties.Name="{DynamicResource NavShortcut}"
                            Click="ShortcutNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨" Foreground="#F6C85F" Width="24"/>
                            <TextBlock Text="{DynamicResource NavShortcut}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GeneralNavButton" Style="{StaticResource SidebarButtonStyle}"
                            AutomationProperties.Name="{DynamicResource NavGeneral}"
                            Click="GeneralNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Foreground="#8F9BAD" Width="24"/>
                            <TextBlock Text="{DynamicResource NavGeneral}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Background="#111B28" BorderBrush="#213044" BorderThickness="1"
                        CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="SaveStatusText" Text="{DynamicResource Saved}" Foreground="#8F9BAD"
                                   FontSize="11"/>
                        <Button x:Name="UndoButton" Content="{DynamicResource UndoLast}" Margin="0,10,0,0"
                                Click="Undo_Click" Padding="9,7" FontSize="11"/>
                        <TextBlock Text="{DynamicResource CloseHides}" Foreground="#66758A" FontSize="10"
                                   Margin="2,9,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="30,26,30,24">
            <Grid x:Name="WheelPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WheelTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource WheelSubtitle}"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#10202B" BorderBrush="#23546A" BorderThickness="1"
                            CornerRadius="9" Padding="13,9" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource WheelReady}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="EditingTargetScrollThumbStyle" TargetType="Thumb">
                                    <Setter Property="Width" Value="6"/>
                                    <Setter Property="MinHeight" Value="30"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Background="#536174"
                                                        CornerRadius="3"
                                                        Margin="2,1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Background"
                                                                Value="#718196"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Background"
                                                                Value="#8999AE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Opacity"
                                                                Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="10"/>
                                    <Setter Property="MinWidth" Value="10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track"
                                                           IsDirectionReversed="True"
                                                           Orientation="{TemplateBinding Orientation}"
                                                           Focusable="False">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                          Focusable="False"
                                                                          IsTabStop="False"
                                                                          Opacity="0"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource EditingTargetScrollThumbStyle}"/>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                          Focusable="False"
                                                                          IsTabStop="False"
                                                                          Opacity="0"/>
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Orientation" Value="Horizontal">
                                                        <Setter Property="Width" Value="Auto"/>
                                                        <Setter Property="Height" Value="10"/>
                                                        <Setter TargetName="PART_Track"
                                                                Property="IsDirectionReversed"
                                                                Value="False"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{DynamicResource EditingTarget}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"/>
                                <ListBox x:Name="TargetList" Margin="0,7,0,0" MaxHeight="154"
                                         SelectionChanged="TargetList_SelectionChanged"
                                         AutomationProperties.Name="{DynamicResource EditingTarget}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="◎" Foreground="#6FB9D5" FontSize="15"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TargetArrow" Grid.Column="2" Text="›"
                                                           Foreground="#7E93AA" FontSize="18"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                                    <Setter TargetName="TargetArrow" Property="Text" Value="•"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <ListBox x:Name="ItemsList" Grid.Row="2"
                                     SelectionChanged="ItemsList_SelectionChanged"
                                     AllowDrop="True" Drop="ItemsList_Drop"
                                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ItemsList_PreviewMouseMove">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="AutomationProperties.Name"
                                                Value="{Binding Path=., Converter={StaticResource ItemCaptionConverter}}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding Path=., Converter={StaticResource ItemCaptionConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8"
                                                    Background="#1B2A3C" VerticalAlignment="Center">
                                                <TextBlock Text="•" FontSize="19" Foreground="#4CC9F0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Path=., Converter={StaticResource ItemCaptionConverter}}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path=., Converter={StaticResource ItemTypeNameConverter}}" Foreground="#7F8DA1"
                                                           FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="⋮⋮" Foreground="#5B6A7D"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{DynamicResource AddItem}" Click="AddItem_Click"
                                            HorizontalContentAlignment="Center" Background="#193045"
                                            BorderBrush="#2B566E"/>
                                    <Button x:Name="AddGroupButton" Grid.Column="1" Content="{DynamicResource NewGroup}"
                                            Click="AddGroup_Click" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="ItemCountText" Foreground="#718096" FontSize="10"
                                           Margin="2,9,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <Grid>
                            <ScrollViewer x:Name="ItemEditorScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ItemEditorPanel" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="EditorHeading" Text="{DynamicResource SelectItem}"
                                                       FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="EditorSubheading"
                                                       Text="{DynamicResource SelectItemHelp}"
                                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="DeleteItemButton" Grid.Column="1"
                                                Content="{DynamicResource Remove}" Foreground="#FF8C96"
                                                BorderBrush="#57303A" Click="DeleteItem_Click"
                                                VerticalAlignment="Top" Visibility="Collapsed"/>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource ItemType}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="ItemTypeBox"
                                                      SelectionChanged="ItemTypeBox_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource DisplayName}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ItemNameBox" TextChanged="ItemNameBox_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="TargetLabel" Text="{DynamicResource TargetPath}" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TargetBox" Grid.Column="0"
                                                 TextChanged="TargetBox_TextChanged"/>
                                        <Button x:Name="BrowseTargetButton" Grid.Column="2" Content="{DynamicResource Browse}"
                                                Click="BrowseTarget_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="TargetFeedbackText" FontSize="10"
                                               Margin="2,6,0,0" TextWrapping="Wrap"
                                               Foreground="#7F8DA1"/>

                                    <StackPanel x:Name="ArgumentsPanel">
                                        <TextBlock Text="{DynamicResource Arguments}"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ArgumentsBox"
                                                 TextChanged="ArgumentsBox_TextChanged"/>
                                    </StackPanel>

                                    <Border x:Name="GroupNotice" Visibility="Collapsed" Background="#172535"
                                            BorderBrush="#2B4A63" BorderThickness="1" CornerRadius="8"
                                            Padding="12" Margin="0,16,0,0">
                                        <TextBlock Text="{DynamicResource GroupNotice}"
                                                   Foreground="#AFC3D8" TextWrapping="Wrap" FontSize="11"/>
                                    </Border>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource ItemColor}" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ItemColorSwatch" Width="27" Height="27"
                                                        CornerRadius="7" BorderBrush="#40536A"
                                                        BorderThickness="1" VerticalAlignment="Center"/>
                                                <TextBox x:Name="ItemColorBox" Grid.Column="1"
                                                         LostKeyboardFocus="ItemColorBox_LostKeyboardFocus"/>
                                                <Button x:Name="PickItemColorButton" Grid.Column="3" Content="{DynamicResource Pick}"
                                                        Click="PickItemColor_Click"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource NameVisibility}" Style="{StaticResource FieldLabel}"/>
                                            <CheckBox x:Name="ShowNameCheckbox" Content="{DynamicResource ShowName}"
                                                      Checked="ShowNameCheckbox_Changed"
                                                      Unchecked="ShowNameCheckbox_Changed"
                                                      Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="AutoColorCheckbox"
                                                  Content="{DynamicResource AutoColor}"
                                                  Checked="AutoColorCheckbox_Changed"
                                                  Unchecked="AutoColorCheckbox_Changed"/>
                                        <Button x:Name="SuggestColorButton" Grid.Column="1"
                                                Content="{DynamicResource SuggestColor}"
                                                Click="SuggestColor_Click" Margin="8,0,0,0" Padding="10,6"/>
                                    </Grid>
                                    <TextBlock x:Name="ColorModeHintText" Foreground="#7F8DA1" FontSize="10"
                                               Margin="2,5,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="{DynamicResource Icon}" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="IconSourceBox" Grid.Column="0"
                                                  SelectionChanged="IconSourceBox_SelectionChanged"/>
                                        <ComboBox x:Name="BuiltInIconBox" Grid.Column="2"
                                                  SelectionChanged="BuiltInIconBox_SelectionChanged"/>
                                        <TextBox x:Name="IconValueBox" Grid.Column="2" Visibility="Collapsed"
                                                 TextChanged="IconValueBox_TextChanged"/>
                                        <Button x:Name="BrowseIconButton" Grid.Column="4"
                                                Content="{DynamicResource Choose}" Click="BrowseIcon_Click"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="IconFeedbackText" Foreground="#7F8DA1" FontSize="10"
                                               Margin="2,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource DropReorder}"
                                               Foreground="#637287" FontSize="10" Margin="2,16,0,4"/>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel x:Name="EmptyEditorPanel" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="70" Height="70" CornerRadius="35" Background="#152233"
                                        BorderBrush="#2B4259" BorderThickness="1">
                                    <TextBlock Text="+" FontSize="30" Foreground="#65839E"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource NoItemSelected}" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                <TextBlock Text="{DynamicResource AddOrSelect}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="AppearancePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource AppearanceTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource AppearanceSubtitle}"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource SavedThemes}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <ListBox x:Name="ThemeList" Grid.Row="2"
                                     SelectionChanged="ThemeList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ThemeKindText" Foreground="#75859A"
                                                           FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6"
                                                    Background="{Binding Accent}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                            <Setter TargetName="ThemeKindText" Property="Text"
                                                    Value="{DynamicResource BuiltIn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                            <Setter TargetName="ThemeKindText" Property="Text"
                                                    Value="{DynamicResource Custom}"/>
                                        </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3">
                                <Button Content="{DynamicResource CreateCustomTheme}" Click="AddTheme_Click"
                                        HorizontalContentAlignment="Center" Background="#193045"
                                        BorderBrush="#2B566E"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource PanelCard}" Height="400" Padding="8">
                                <Grid>
                                    <Grid.Background>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                                             RadiusX="0.7" RadiusY="0.7">
                                            <GradientStop Color="#162234" Offset="0"/>
                                            <GradientStop Color="#0B111A" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Grid.Background>
                                    <ui:RadialWheelControl x:Name="PreviewWheel" IsOverlay="True"
                                                           DesiredDiameter="300" Margin="20"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="#990A111A" CornerRadius="6" Padding="8,4"
                                            Margin="14">
                                        <TextBlock Text="{DynamicResource LivePreview}"
                                                   Foreground="#8494A8" FontSize="9"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ThemeDetails}" FontSize="17" FontWeight="SemiBold"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource ThemeName}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ThemeNameBox"
                                                     LostKeyboardFocus="ThemeField_LostKeyboardFocus"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource AccentColor}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ThemeAccentBox"
                                                     LostKeyboardFocus="ThemeField_LostKeyboardFocus"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource SectorColor}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ThemeSectorBox"
                                                     LostKeyboardFocus="ThemeField_LostKeyboardFocus"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource TextColor}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ThemeTextBox"
                                                     LostKeyboardFocus="ThemeField_LostKeyboardFocus"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource BackgroundTint}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ThemeBackgroundBox"
                                                 LostKeyboardFocus="ThemeField_LostKeyboardFocus"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="OpacityLabel" Text="{DynamicResource Opacity}"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1"
                                                    TickFrequency="0.05" ValueChanged="ThemeSlider_ValueChanged"
                                                    PreviewMouseLeftButtonDown="ThemeSlider_PreviewMouseLeftButtonDown"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="DimmingLabel" Text="{DynamicResource BackgroundDimming}"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="DimmingSlider" Minimum="0" Maximum="0.8"
                                                    TickFrequency="0.05" ValueChanged="ThemeSlider_ValueChanged"
                                                    PreviewMouseLeftButtonDown="ThemeSlider_PreviewMouseLeftButtonDown"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="WheelSizeLabel" Text="{DynamicResource WheelSize}"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="WheelSizeSlider" Minimum="190" Maximum="460"
                                                    TickFrequency="10" ValueChanged="ThemeSlider_ValueChanged"
                                                    PreviewMouseLeftButtonDown="ThemeSlider_PreviewMouseLeftButtonDown"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="AnimationDurationLabel"
                                                       Text="{DynamicResource AnimationDuration}"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="AnimationDurationSlider" Minimum="60" Maximum="400"
                                                    TickFrequency="10" ValueChanged="ThemeSlider_ValueChanged"
                                                    PreviewMouseLeftButtonDown="ThemeSlider_PreviewMouseLeftButtonDown"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="AnimationCheckbox" Content="{DynamicResource AnimateWheel}"
                                              Checked="AnimationCheckbox_Changed"
                                              Unchecked="AnimationCheckbox_Changed" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="ThemeValidationText" Foreground="#FF8C96"
                                               FontSize="10" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="ShortcutPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource ShortcutTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource ShortcutSubtitle}"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource PanelCard}" MaxWidth="780" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ActivationShortcut}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource ShortcutHelp}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,15"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#0A1018" BorderBrush="#31455C"
                                        BorderThickness="1" CornerRadius="9" Padding="16,14">
                                    <TextBlock x:Name="ShortcutDisplayText" FontSize="18"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Button x:Name="RecordShortcutButton" Grid.Column="2"
                                        Content="{DynamicResource RecordShortcut}" Click="RecordShortcut_Click"
                                        Background="#193045" BorderBrush="#2B566E"/>
                            </Grid>
                            <TextBlock x:Name="ShortcutValidationText" Foreground="#FF9A72"
                                       Margin="2,12,0,0" TextWrapping="Wrap"/>
                            <Border Background="#101A25" BorderBrush="#233247" BorderThickness="1"
                                    CornerRadius="9" Padding="13" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HowActivationWorks}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="#7F90A5"/>
                                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                                               Foreground="#B4C1D1"
                                               Text="{DynamicResource ActivationExplanation}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" MaxWidth="780" HorizontalAlignment="Left"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RegistrationStatus}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ShortcutRegistrationText" Foreground="#8F9BAD"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="GeneralPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource GeneralTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource GeneralSubtitle}"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource WindowsIntegration}" FontSize="18" FontWeight="SemiBold"/>
                                <CheckBox x:Name="StartWithWindowsCheckbox"
                                          Content="{DynamicResource LaunchWithWindows}"
                                          Checked="StartWithWindowsCheckbox_Changed"
                                          Unchecked="StartWithWindowsCheckbox_Changed"
                                          Margin="0,16,0,0"/>
                                <TextBlock Text="{DynamicResource StartupDescription}"
                                           Foreground="#7F8EA2" FontSize="10" Margin="22,5,0,0"
                                           TextWrapping="Wrap"/>
                                <CheckBox x:Name="TrayNotificationsCheckbox"
                                          Content="{DynamicResource ShowNotifications}"
                                          Checked="TrayNotificationsCheckbox_Changed"
                                          Unchecked="TrayNotificationsCheckbox_Changed"
                                          Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Language}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource LanguageDescription}"
                                           Foreground="#8F9BAD" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left"
                                          SelectionChanged="LanguageBox_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ExportImport}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource TransferDescription}"
                                           Foreground="#8F9BAD" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Export}" Click="ExportConfiguration_Click"
                                            Background="#193045" BorderBrush="#2B566E"/>
                                    <Button Content="{DynamicResource Import}" Click="ImportConfiguration_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LocalConfiguration}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource ConfigurationDescription}"
                                           Foreground="#8F9BAD" Margin="0,5,0,9"/>
                                <TextBox x:Name="ConfigurationPathBox" IsReadOnly="True"
                                         Foreground="#AFC4D8"/>
                                <Button Content="{DynamicResource OpenConfigurationFolder}" Click="OpenConfigFolder_Click"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource About}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#A6B4C5"
                                           Text="{DynamicResource AboutDescription}"/>
                                <TextBlock Margin="0,14,0,0" Foreground="#7D8DA1" TextWrapping="Wrap"
                                           Text="{DynamicResource TrayNote}"/>
                                <Button Content="{DynamicResource ExitApplication}" Click="ExitButton_Click"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Foreground="#FF8C96" BorderBrush="#57303A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

